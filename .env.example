# 仅列出变量名称/安全默认值；请通过进程环境配置，不要提交真实凭据。
AGENTFLOW_DATABASE_URL=
AGENTFLOW_API_TOKEN=
AGENTFLOW_POSTGRES_PASSWORD=

# 模型：默认离线 mock。
AGENTFLOW_PROVIDER=mock
AGENTFLOW_MODEL=deepseek-chat
AGENTFLOW_MODEL_BASE_URL=https://api.deepseek.com
AGENTFLOW_DEEPSEEK_API_KEY=

# Worker baseline tuning。
AGENTFLOW_CONCURRENCY=4
AGENTFLOW_LEASE_SECONDS=30
AGENTFLOW_POLL_SECONDS=0.5

# 可选能力。标准 Compose 不向 worker 暴露宿主 Docker daemon 或任意工具目录。
AGENTFLOW_TOOL_ROOT=
AGENTFLOW_SANDBOX_ENABLED=false
AGENTFLOW_SANDBOX_IMAGE=agentflow-sandbox:1.0
AGENTFLOW_MCP_COMMAND=
AGENTFLOW_MCP_ARGS=[]
AGENTFLOW_MCP_TOOLS=[]

# 观测。
AGENTFLOW_TELEMETRY=false
AGENTFLOW_GRAFANA_PASSWORD=
